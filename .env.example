# Copy to .env and fill in. Every EXPO_PUBLIC_ value is public (readable from the APK):
# never put a secret here. Read only in src/constants/config.ts (context/details/1020).

# local · dev · prod (missing or unknown → prod, which hides the testing menu)
EXPO_PUBLIC_APP_ENV=local

# Your server, e.g. your PC on the LAN running uvicorn on port 8000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000
